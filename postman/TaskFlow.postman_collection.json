            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TaskFlow Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"organizationName\": \"TaskFlow Demo Organization\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a disposable admin user and organization. If already created, continue with Login Admin."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"adminEmail\", `taskflow.${Date.now()}$@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Registered\", () => pm.expect(pm.response.code).to.be.oneOf([201,409]));"
